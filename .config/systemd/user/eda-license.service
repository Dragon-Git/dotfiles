[Unit]
Description=EDA License Server Daemon
After=network.target # 指定启动顺序依赖网络
   
[Service]
Type=simple
User=eda_user # 指定运行用户，更安全
ExecStart=/path/to/your/lmgrd -c /path/to/license.dat
Restart=on-failure # 失败时自动重启
RestartSec=5s
# 可以添加资源限制，例如：
# MemoryMax=2G
# CPUQuota=80%
   
[Install]
WantedBy=multi-user.target
